# This env file uses @env-spec - see https://varlock.dev/env-spec for more info

# NOTE: Plugins must be imported before configuration
# INFISICAL
# @plugin(@varlock/infisical-plugin@1.2.0)
#
# @initInfisical(
#   siteUrl="https://eu.infisical.com",
#   projectId="39ac1a7b-c37c-4721-8e4d-ad20f2a60b03",
#   environment="dev",
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET
# )
# ----------

# CONFIG
# @defaultRequired=infer @defaultSensitive=false
# Note: modify the path to auto import types in nuxt
# @generateTypes(lang=ts, path="./shared/types/env.d.ts")
# ----------

# @type=infisicalClientId @required
INFISICAL_CLIENT_ID=
#
# @type=infisicalClientSecret @sensitive @required
INFISICAL_CLIENT_SECRET=
# ----------

# ----------
# ----------
# ----------
# ----------


# ── Sanity ───────────────────────────────
# @required @type=string
SANITY_PROJECT_ID=infisical()

# @required @type=string
SANITY_DATASET=infisical()

# @sensitive @required
SANITY_TOKEN_READ_ONLY=infisical()

# @sensitive @required
SANITY_TOKEN=infisical()
# @sensitive @required
RESERVATIONS_API_TOKEN=infisical()

# ── Google Maps ──────────────────────────
# @sensitive @required
GOOGLE_MAPS_PLACES_API_KEY=infisical()

# @required @type=string
GOOGLE_MAPS_PLACE_ID=infisical()

# ── Email / Brevo SMTP ───────────────────
# @required @type=string
EMAIL_SENDER=infisical()

# @required @type=string
BREVO_SMTP_HOST=infisical()

# @required @type=port
BREVO_SMTP_PORT=infisical()

# @required @type=string
BREVO_SMTP_USER=infisical()

# @sensitive @required
BREVO_SMTP_KEY=infisical()

# @sensitive @required
BREVO_API_KEY=infisical()

# ── Nuxt / OG Image ──────────────────────
# @sensitive @required
NUXT_OG_IMAGE_SECRET=infisical()
